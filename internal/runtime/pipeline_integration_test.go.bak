// ======================================================================
// End-to-end pipeline test: XML → parse → validate → execute
// ======================================================================

// TestE2E_XmlToExecution tests the full pipeline from XML extraction
// through schema validation to tool execution.
func TestE2E_XmlToExecution(t *testing.T) {
	loop := newTestLoop(t)

	// Step 1: Model emits XML tool call
	xml := `<tool_calls><invoke name="bash"><parameter name="command">echo integration-test-pass</parameter></invoke></tool_calls>`

	// Step 2: Extract tool calls from XML
	toolCalls := api.ExtractXmlToolCalls(xml)
	if len(toolCalls) != 1 {
		t.Fatalf("ExtractXmlToolCalls returned %d calls, want 1", len(toolCalls))
	}
	tc := toolCalls[0]
	if tc.Name != "bash" {
		t.Errorf("tool name = %q, want bash", tc.Name)
	}

	// Step 3: Parse JSON arguments
	var inputMap map[string]any
	if err := json.Unmarshal([]byte(tc.Arguments), &inputMap); err != nil {
		// Try self-healing
		healed := HealToolInput(tc.Name, tc.Arguments, err)
		if healed != nil {
			t.Fatalf("self-healing kicked in but shouldn't have for valid JSON: %s", healed.Content[0].Text)
		}
		t.Fatalf("JSON parse failed: %v", err)
	}

	// Step 4: Validate against schema
	if err := loop.validateToolInput(tc.Name, inputMap); err != nil {
		t.Fatalf("validateToolInput rejected valid input: %v", err)
	}

	// Step 5: Execute tool
	result := loop.ExecuteTool(tc.Name, inputMap)
	if result.IsError {
		t.Fatalf("ExecuteTool returned error: %s", result.Content[0].Text)
	}
	if !strings.Contains(result.Content[0].Text, "integration-test-pass") {
		t.Errorf("bash output missing expected text: %q", result.Content[0].Text)
	}
}

// TestE2E_XmlWithMissingArgs tests the full pipeline when XML tool call
// is missing a required argument.
func TestE2E_XmlWithMissingArgs(t *testing.T) {
	loop := newTestLoop(t)

	// Model emits bash tool call without command parameter
	xml := `<tool_calls><invoke name="bash"></invoke></tool_calls>`

	toolCalls := api.ExtractXmlToolCalls(xml)
	if len(toolCalls) != 1 {
		t.Fatalf("ExtractXmlToolCalls returned %d calls, want 1", len(toolCalls))
	}
	tc := toolCalls[0]

	var inputMap map[string]any
	if tc.Arguments != "" {
		_ = json.Unmarshal([]byte(tc.Arguments), &inputMap)
	}
	if inputMap == nil {
		inputMap = map[string]any{}
	}

	// Self-healing should catch the missing required field
	healed := HealToolInput(tc.Name, "{}", nil)
	if healed == nil {
		t.Fatal("HealToolInput should catch missing 'command' field")
	}
	if !healed.IsError {
		t.Error("healed result should be an error")
	}
	text := healed.Content[0].Text
	if !strings.Contains(text, "command") {
		t.Errorf("error should mention 'command': %q", text)
	}
}

// TestE2E_XmlWithMalformedJSON tests the full pipeline when XML tool call
// has malformed JSON arguments.
func TestE2E_XmlWithMalformedJSON(t *testing.T) {
	loop := newTestLoop(t)

	// Model emits bash tool call with truncated JSON
	xml := `<tool_calls><invoke name="bash"><parameter name="command">echo hello</parameter></invoke></tool_calls>`

	toolCalls := api.ExtractXmlToolCalls(xml)
	if len(toolCalls) != 1 {
		t.Fatalf("ExtractXmlToolCalls returned %d calls, want 1", len(toolCalls))
	}

	// Simulate malformed JSON in inputBuffer (as would happen in streaming)
	malformedRaw := `{"command":`
	var inputMap map[string]any
	err := json.Unmarshal([]byte(malformedRaw), &inputMap)

	healed := HealToolInput("bash", malformedRaw, err)
	if healed == nil {
		t.Fatal("HealToolInput should produce error for malformed JSON")
	}
	if !healed.IsError {
		t.Error("healed result should be an error")
	}
	text := healed.Content[0].Text
	if !strings.Contains(text, "JSON") {
		t.Errorf("error should mention 'JSON': %q", text)
	}
}

// TestE2E_StrictValidationInPipeline tests that strict validation
// correctly catches enum violations in the full pipeline context.
// This documents the gap: currently validateToolInput uses only
// lightweight validation, so enum violations pass through to the
// tool implementation. When strict validation is wired in, this
// test should be updated.
func TestE2E_StrictValidationInPipeline(t *testing.T) {
	schema, ok := tools.Schema("todo_write")
	if !ok {
		t.Fatal("todo_write schema not found")
	}

	// Invalid action enum — lightweight misses it, strict catches it
	args := map[string]any{"action": "delete"}

	// Lightweight (current validateToolInput path)
	lightweightErr := api.ValidateToolCallArguments("todo_write", args, schema)
	if lightweightErr != nil {
		t.Logf("lightweight validation caught it (unexpected but good): %v", lightweightErr)
	} else {
		t.Log("lightweight validation missed enum violation (expected — it only checks required+type)")
	}

	// Strict (should catch it)
	strictErr := api.StrictValidateToolCallArguments("todo_write", args, schema)
	if strictErr == nil {
		t.Fatal("strict validation should catch enum violation")
	}
	if !errors.Is(strictErr, api.ErrSchema) {
		t.Errorf("strict error should wrap ErrSchema: %v", strictErr)
	}
}

// TestE2E_StrictValidationNestedArray tests strict validation
// catching nested errors in todo_write array items.
func TestE2E_StrictValidationNestedArray(t *testing.T) {
	schema, ok := tools.Schema("todo_write")
	if !ok {
		t.Fatal("todo_write schema not found")
	}

	testCases := []struct {
		name string
		args map[string]any
		want string // substring expected in error
	}{
		{
			name: "invalid status enum in array item",
			args: map[string]any{
				"action": "write",
				"todos": []any{
					map[string]any{
						"id":       "1",
						"content":  "task",
						"status":   "unknown",
						"priority": "high",
					},
				},
			},
			want: "status",
		},
		{
			name: "invalid priority enum in array item",
			args: map[string]any{
				"action": "write",
				"todos": []any{
					map[string]any{
						"id":       "1",
						"content":  "task",
						"status":   "pending",
						"priority": "critical",
					},
				},
			},
			want: "priority",
		},
		{
			name: "missing required fields in array item",
			args: map[string]any{
				"action": "write",
				"todos": []any{
					map[string]any{
						"id": "1",
						// missing content, status, priority
					},
				},
			},
			want: "required",
		},
		{
			name: "non-string status in array item",
			args: map[string]any{
				"action": "write",
				"todos": []any{
					map[string]any{
						"id":       "1",
						"content":  "task",
						"status":   42,
						"priority": "high",
					},
				},
			},
			want: "status",
		},
	}

	for _, tc := range testCases {
		t.Run(tc.name, func(t *testing.T) {
			err := api.StrictValidateToolCallArguments("todo_write", tc.args, schema)
			if err == nil {
				t.Fatal("expected error from strict validation")
			}
			errText := err.Error()
			if !strings.Contains(strings.ToLower(errText), strings.ToLower(tc.want)) {
				t.Errorf("error %q should contain %q", errText, tc.want)
			}
		})
	}
}

// TestE2E_FullValidTodoWrite tests the complete end-to-end flow for
// a valid todo_write call with array items through strict validation.
func TestE2E_FullValidTodoWrite(t *testing.T) {
	schema, ok := tools.Schema("todo_write")
	if !ok {
		t.Fatal("todo_write schema not found")
	}

	args := map[string]any{
		"action": "write",
		"todos": []any{
			map[string]any{
				"id":       "t1",
				"content":  "implement pipeline integration tests",
				"status":   "in_progress",
				"priority": "high",
			},
			map[string]any{
				"id":       "t2",
				"content":  "wire strict validation into validateToolInput",
				"status":   "pending",
				"priority": "medium",
			},
		},
	}

	err := api.StrictValidateToolCallArguments("todo_write", args, schema)
	if err != nil {
		t.Errorf("valid todo_write should pass strict validation: %v", err)
	}
}

// ======================================================================
// Benchmarks
// ======================================================================

func BenchmarkPipeline_ExecuteBash(b *testing.B) {
	cfg := LoadConfig()
	cfg.PermissionMode = "bypass"
	cfg.MaxTokens = 1024
	cfg.SessionDir = b.TempDir()

	loop := NewConversationLoop(cfg, mockAPIClient{})
	loop.PermManager = permissions.NewManager(permissions.ModeBypassPermissions, &permissions.Ruleset{})

	input := map[string]any{"command": "echo benchmark"}
	b.ResetTimer()
	for i := 0; i < b.N; i++ {
		loop.ExecuteTool("bash", input)
	}
}

func BenchmarkPipeline_ExecuteBashInvalid(b *testing.B) {
	cfg := LoadConfig()
	cfg.PermissionMode = "bypass"
	cfg.MaxTokens = 1024
	cfg.SessionDir = b.TempDir()

	loop := NewConversationLoop(cfg, mockAPIClient{})
	loop.PermManager = permissions.NewManager(permissions.ModeBypassPermissions, &permissions.Ruleset{})

	input := map[string]any{} // missing command — triggers validation
	b.ResetTimer()
	for i := 0; i < b.N; i++ {
		loop.ExecuteTool("bash", input)
	}
}

func BenchmarkPipeline_ValidateToolInput(b *testing.B) {
	cfg := LoadConfig()
	cfg.PermissionMode = "bypass"
	cfg.MaxTokens = 1024
	cfg.SessionDir = b.TempDir()

	loop := NewConversationLoop(cfg, mockAPIClient{})
	loop.PermManager = permissions.NewManager(permissions.ModeBypassPermissions, &permissions.Ruleset{})

	b.ResetTimer()
	for i := 0; i < b.N; i++ {
		loop.validateToolInput("bash", map[string]any{"command": "ls"})
	}
}

func BenchmarkPipeline_StrictValidationTodoWrite(b *testing.B) {
	schema, _ := tools.Schema("todo_write")
	args := map[string]any{
		"action": "write",
		"todos": []any{
			map[string]any{
				"id":       "1",
				"content":  "benchmark task",
				"status":   "pending",
				"priority": "high",
			},
		},
	}
	b.ResetTimer()
	for i := 0; i < b.N; i++ {
		api.StrictValidateToolCallArguments("todo_write", args, schema)
	}
}

