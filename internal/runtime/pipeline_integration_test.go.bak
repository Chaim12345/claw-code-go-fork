// ======================================================================
// Self-healing integration tests
// ======================================================================

// TestSelfHealingIntegration_MalformedJSON tests the full self-healing
// path: when the model emits malformed JSON for a tool call,
// HealToolInput produces an error tool_result that the model can
// self-correct on the next turn.
func TestSelfHealingIntegration_MalformedJSON(t *testing.T) {
	raw := `{"command":` // truncated
	var inputMap map[string]any
	err := json.Unmarshal([]byte(raw), &inputMap)

	healed := HealToolInput("bash", raw, err)
	if healed == nil {
		t.Fatal("expected healed tool_result for malformed JSON")
	}
	if healed.Type != "tool_result" {
		t.Errorf("healed.Type = %q, want tool_result", healed.Type)
	}
	if !healed.IsError {
		t.Error("healed.IsError = false, want true")
	}
	text := healed.Content[0].Text
	if !strings.Contains(text, "bash") {
		t.Errorf("healed text missing tool name: %q", text)
	}
	if !strings.Contains(text, "JSON") {
		t.Errorf("healed text missing 'JSON': %q", text)
	}
}

// TestSelfHealingIntegration_MissingRequired tests that HealToolInput
// catches missing required fields in valid JSON.
func TestSelfHealingIntegration_MissingRequired(t *testing.T) {
	raw := `{}` // valid JSON, but "command" is required
	var inputMap map[string]any
	_ = json.Unmarshal([]byte(raw), &inputMap)

	healed := HealToolInput("bash", raw, nil)
	if healed == nil {
		t.Fatal("expected healed tool_result for missing required field")
	}
	if !healed.IsError {
		t.Error("healed.IsError = false, want true")
	}
	text := healed.Content[0].Text
	if !strings.Contains(text, "command") {
		t.Errorf("healed text missing required field name: %q", text)
	}
}

// TestSelfHealingIntegration_ValidArgs tests that HealToolInput returns
// nil for valid JSON with all required fields present.
func TestSelfHealingIntegration_ValidArgs(t *testing.T) {
	raw := `{"command": "ls"}`
	var inputMap map[string]any
	err := json.Unmarshal([]byte(raw), &inputMap)

	healed := HealToolInput("bash", raw, err)
	if healed != nil {
		t.Errorf("expected nil for valid JSON, got: %+v", healed)
	}
}

// ======================================================================
// Strict validation integration tests
