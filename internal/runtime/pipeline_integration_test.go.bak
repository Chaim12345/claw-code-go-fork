// --- Mock APIClient for integration tests ---
// The mock is minimal — we only need StreamResponse to satisfy the
// ConversationLoop constructor. The actual pipeline tests call
// ExecuteTool / ExecuteToolQuiet / validateToolInput directly,
// bypassing the streaming path entirely.

type mockAPIClient struct{}

func (mockAPIClient) StreamResponse(_ context.Context, _ api.CreateMessageRequest) (<-chan api.StreamEvent, error) {
	ch := make(chan api.StreamEvent)
	close(ch)
	return ch, nil
}

func (mockAPIClient) MaxInputTokens() int { return 128000 }

// newTestLoop creates a ConversationLoop with bypass permissions
// and a mock API client for integration testing.
func newTestLoop(t *testing.T) *ConversationLoop {
	t.Helper()
	cfg := LoadConfig()
	cfg.PermissionMode = "bypass"
	cfg.MaxTokens = 1024
	cfg.SessionDir = t.TempDir()

	loop := NewConversationLoop(cfg, mockAPIClient{})
	loop.PermManager = permissions.NewManager(permissions.ModeBypassPermissions, &permissions.Ruleset{})
	return loop
}

// ======================================================================
// Pipeline integration tests: validateToolInput → ExecuteTool
// ======================================================================

// TestPipeline_ValidBashCall tests that a well-formed bash tool call
// passes validation and executes successfully.
func TestPipeline_ValidBashCall(t *testing.T) {
	loop := newTestLoop(t)

	input := map[string]any{"command": "echo hello"}
	result := loop.ExecuteTool("bash", input)

	if result.IsError {
		t.Fatalf("valid bash call returned error: %s", result.Content[0].Text)
	}
	text := result.Content[0].Text
	if !strings.Contains(text, "hello") {
		t.Errorf("bash output missing 'hello': %q", text)
	}
}

// TestPipeline_MissingRequiredField tests that a bash call without
// the required "command" field is rejected by schema validation.
func TestPipeline_MissingRequiredField(t *testing.T) {
	loop := newTestLoop(t)

	input := map[string]any{} // missing "command"
	result := loop.ExecuteTool("bash", input)

	if !result.IsError {
		t.Fatal("expected IsError=true for missing required field")
	}
	text := result.Content[0].Text
	if !strings.Contains(text, "command") {
		t.Errorf("error message missing field name: %q", text)
	}
	if !strings.Contains(text, "required") {
		t.Errorf("error message missing 'required': %q", text)
	}
}

// TestPipeline_TypeMismatch tests that a bash call with the wrong
// type for "command" (integer instead of string) is rejected.
func TestPipeline_TypeMismatch(t *testing.T) {
	loop := newTestLoop(t)

	input := map[string]any{"command": 42} // int, not string
	result := loop.ExecuteTool("bash", input)

	if !result.IsError {
		t.Fatal("expected IsError=true for type mismatch")
	}
	text := result.Content[0].Text
	if !strings.Contains(text, "command") {
		t.Errorf("error message missing field name: %q", text)
	}
}

// TestPipeline_ValidTodoWrite tests that a well-formed todo_write call
// with action="read" passes validation and executes.
func TestPipeline_ValidTodoWrite(t *testing.T) {
	loop := newTestLoop(t)
	_ = os.Chdir(t.TempDir()) // isolate from project's .claude dir

	input := map[string]any{"action": "read"}
	result := loop.ExecuteTool("todo_write", input)

	if result.IsError {
		t.Fatalf("valid todo_write read returned error: %s", result.Content[0].Text)
	}
}

// TestPipeline_TodoWriteEnumViolation tests that todo_write with an
// invalid action enum value ("delete" instead of "read"/"write") is
// rejected by the lightweight validator. Note: the lightweight
// ValidateToolCallArguments only checks required+type, so enum
// violations pass through it. This test documents the current
// behavior and will be updated when strict validation is wired in.
func TestPipeline_TodoWriteEnumViolation_Lightweight(t *testing.T) {
	loop := newTestLoop(t)

	// The lightweight validator doesn't check enums, so "delete"
	// passes validation and the tool itself returns an error.
	input := map[string]any{"action": "delete"}
	result := loop.ExecuteTool("todo_write", input)

	if !result.IsError {
		t.Fatal("expected error for invalid action enum")
	}
	text := result.Content[0].Text
	// The error comes from the tool implementation, not schema validation
	if !strings.Contains(text, "delete") && !strings.Contains(text, "action") {
		t.Errorf("error message should mention the invalid action: %q", text)
	}
}

