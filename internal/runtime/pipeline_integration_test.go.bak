// TestStrictValidation_EnumViolation tests that strict validation
// catches enum violations that the lightweight validator misses.
func TestStrictValidation_EnumViolation(t *testing.T) {
	schema, ok := tools.Schema("todo_write")
	if !ok {
		t.Fatal("todo_write schema not found")
	}

	// "action" has Enum: ["read", "write"], "delete" is invalid
	args := map[string]any{"action": "delete"}
	err := api.StrictValidateToolCallArguments("todo_write", args, schema)
	if err == nil {
		t.Fatal("strict validation should reject enum violation")
	}
	if !errors.Is(err, api.ErrSchema) {
		t.Errorf("error should wrap ErrSchema: %v", err)
	}
}

// TestStrictValidation_EnumValid tests that strict validation accepts
// a valid enum value.
func TestStrictValidation_EnumValid(t *testing.T) {
	schema, ok := tools.Schema("todo_write")
	if !ok {
		t.Fatal("todo_write schema not found")
	}

	args := map[string]any{"action": "read"}
	err := api.StrictValidateToolCallArguments("todo_write", args, schema)
	if err != nil {
		t.Errorf("strict validation should accept valid enum: %v", err)
	}
}

// TestStrictValidation_ArrayItemEnum tests that strict validation
// catches enum violations inside array items (todos[].status).
func TestStrictValidation_ArrayItemEnum(t *testing.T) {
	schema, ok := tools.Schema("todo_write")
	if !ok {
		t.Fatal("todo_write schema not found")
	}

	// todos[].status has Enum: ["pending", "in_progress", "done"]
	// "blocked" is invalid
	args := map[string]any{
		"action": "write",
		"todos": []any{
			map[string]any{
				"id":       "1",
				"content":  "test task",
				"status":   "blocked", // invalid enum
				"priority": "high",
			},
		},
	}
	err := api.StrictValidateToolCallArguments("todo_write", args, schema)
	if err == nil {
		t.Fatal("strict validation should reject array item enum violation")
	}
	if !errors.Is(err, api.ErrSchema) {
		t.Errorf("error should wrap ErrSchema: %v", err)
	}
}

// TestStrictValidation_ArrayItemMissingRequired tests that strict
// validation catches missing required fields inside array items
// (todos[] requires "id", "content", "status", "priority").
func TestStrictValidation_ArrayItemMissingRequired(t *testing.T) {
	schema, ok := tools.Schema("todo_write")
	if !ok {
		t.Fatal("todo_write schema not found")
	}

	// Missing "content" and "status" from todo item
	args := map[string]any{
		"action": "write",
		"todos": []any{
			map[string]any{
				"id":       "1",
				"priority": "high",
				// missing "content" and "status"
			},
		},
	}
	err := api.StrictValidateToolCallArguments("todo_write", args, schema)
	if err == nil {
		t.Fatal("strict validation should reject missing required fields in array items")
	}
	if !errors.Is(err, api.ErrSchema) {
		t.Errorf("error should wrap ErrSchema: %v", err)
	}
}

