{
  "ci": {
    "collect": {
      "url": ["${LIGHTHOUSE_BASE_URL:-http://127.0.0.1:7777}"],
      "numberOfRuns": 1,
      "settings": {
        "chromeFlags": "--headless --no-sandbox",
        "preset": "desktop"
      }
    },
    "assert": {
      "preset": "lighthouse:recommended",
      "assertions": {
        "categories:pwa": ["error", {"minScore": 0.9}]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}